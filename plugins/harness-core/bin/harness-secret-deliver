#!/usr/bin/env python3
"""Consume one secret-delivery receipt and run one fixed SCP transfer."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path


MAX_RECEIPT_BYTES = 16384
MAX_FILE_BYTES = 1024 * 1024
RECEIPT_RE = re.compile(r"[0-9a-f]{64}")
SESSION_RE = re.compile(r"[A-Za-z0-9._:][A-Za-z0-9._:-]{0,127}")
COMPONENT_RE = re.compile(r"[A-Za-z0-9._-]{1,255}")
USER_RE = re.compile(r"[A-Za-z_][A-Za-z0-9._-]{0,63}")
HOST_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,252}")


class DeliveryError(Exception):
    def __init__(self, code: str, exit_code: int = 2) -> None:
        super().__init__(code)
        self.code = code
        self.exit_code = exit_code


class DeliveryArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise DeliveryError("INVALID_ARGUMENT")


def fail(code: str, exit_code: int = 2) -> int:
    print(f"SECRET_DELIVERY_FAILED reason={code}", file=sys.stderr)
    return exit_code


def state_root() -> Path:
    root = Path.home() / ".claude" / "state" / "secret_delivery"
    receipts = root / "receipts"
    if root.is_symlink() or receipts.is_symlink():
        raise DeliveryError("UNSAFE_STATE")
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    receipts.mkdir(mode=0o700, parents=True, exist_ok=True)
    root.chmod(0o700)
    receipts.chmod(0o700)
    return root


def acquire_delivery_lock(root: Path) -> int:
    fd = os.open(root / "delivery.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        os.close(fd)
        raise DeliveryError("DELIVERY_BUSY", 3) from exc
    return fd


def claim_receipt(receipts: Path, receipt_id: str) -> Path:
    pending = receipts / f"{receipt_id}.json"
    claimed = receipts / f"{receipt_id}.claimed"
    try:
        os.link(pending, claimed, follow_symlinks=False)
    except FileExistsError as exc:
        raise DeliveryError("RECEIPT_ALREADY_USED") from exc
    except OSError as exc:
        raise DeliveryError("RECEIPT_NOT_FOUND") from exc
    try:
        pending.unlink()
    except FileNotFoundError:
        pass
    except OSError as exc:
        try:
            claimed.unlink()
        except OSError:
            pass
        raise DeliveryError("RECEIPT_CLAIM_FAILED") from exc
    return claimed


def load_receipt(path: Path) -> dict[str, object]:
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
            raise DeliveryError("UNSAFE_RECEIPT")
        if info.st_size <= 0 or info.st_size > MAX_RECEIPT_BYTES:
            raise DeliveryError("INVALID_RECEIPT")
        raw = path.read_bytes()
        value = json.loads(raw)
    except DeliveryError:
        raise
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeliveryError("INVALID_RECEIPT") from exc
    if not isinstance(value, dict):
        raise DeliveryError("INVALID_RECEIPT")
    expected = {
        "version",
        "receipt_id",
        "source",
        "destination",
        "representation",
        "session_id",
        "created_at",
        "expires_at",
    }
    if set(value) != expected:
        raise DeliveryError("INVALID_RECEIPT")
    return value


def validated_receipt(
    value: dict[str, object], receipt_id: str, session_id: str
) -> tuple[Path, str, int | None]:
    now = int(time.time())
    if (
        value.get("version") != 1
        or value.get("receipt_id") != receipt_id
        or value.get("representation") != "file"
        or value.get("session_id") != session_id
        or not isinstance(value.get("created_at"), int)
        or not isinstance(value.get("expires_at"), int)
        or value["created_at"] > now + 5
        or value["expires_at"] < now
        or value["expires_at"] - value["created_at"] != 120
    ):
        raise DeliveryError("INVALID_OR_EXPIRED_RECEIPT")

    source = value.get("source")
    destination = value.get("destination")
    if not isinstance(source, dict) or set(source) != {
        "path",
        "device",
        "inode",
        "size",
        "mtime_ns",
    }:
        raise DeliveryError("INVALID_RECEIPT")
    if not isinstance(destination, dict) or set(destination) != {
        "user",
        "host",
        "port",
        "path",
    }:
        raise DeliveryError("INVALID_RECEIPT")

    source_path = source.get("path")
    if not isinstance(source_path, str) or not source_path.startswith("/"):
        raise DeliveryError("INVALID_RECEIPT")
    if any(not COMPONENT_RE.fullmatch(part) for part in Path(source_path).parts[1:]):
        raise DeliveryError("INVALID_RECEIPT")
    try:
        info = os.stat(source_path, follow_symlinks=False)
    except OSError as exc:
        raise DeliveryError("SOURCE_CHANGED") from exc
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_dev != source.get("device")
        or info.st_ino != source.get("inode")
        or info.st_size != source.get("size")
        or info.st_mtime_ns != source.get("mtime_ns")
        or not (1 <= info.st_size <= MAX_FILE_BYTES)
    ):
        raise DeliveryError("SOURCE_CHANGED")

    user = destination.get("user")
    host = destination.get("host")
    port = destination.get("port")
    remote_path = destination.get("path")
    if user is not None and (not isinstance(user, str) or not USER_RE.fullmatch(user)):
        raise DeliveryError("INVALID_RECEIPT")
    if not isinstance(host, str) or not HOST_RE.fullmatch(host):
        raise DeliveryError("INVALID_RECEIPT")
    if port is not None and (
        not isinstance(port, int) or isinstance(port, bool) or not (1 <= port <= 65535)
    ):
        raise DeliveryError("INVALID_RECEIPT")
    if not isinstance(remote_path, str) or not remote_path.startswith("/"):
        raise DeliveryError("INVALID_RECEIPT")
    if any(not COMPONENT_RE.fullmatch(part) for part in Path(remote_path).parts[1:]):
        raise DeliveryError("INVALID_RECEIPT")
    target = f"{user + '@' if user else ''}{host}:{remote_path}"
    return Path(source_path), target, port


def require_classified(path: Path) -> None:
    guard = Path(__file__).resolve().parent.parent / "hooks" / "credential_file_read_guard.sh"
    try:
        result = subprocess.run(
            ["bash", str(guard), "--classify-path", str(path)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise DeliveryError("SOURCE_NOT_CLASSIFIED") from exc
    if result.returncode != 0:
        raise DeliveryError("SOURCE_NOT_CLASSIFIED")


def scp_executable() -> str:
    if os.environ.get("HARNESS_SECRET_DELIVERY_TESTING") == "1":
        candidate = os.environ.get("HARNESS_SECRET_DELIVERY_SCP", "")
        if candidate.startswith("/") and os.access(candidate, os.X_OK):
            return candidate
        raise DeliveryError("SCP_UNAVAILABLE")
    candidate = "/usr/bin/scp"
    if not os.access(candidate, os.X_OK):
        raise DeliveryError("SCP_UNAVAILABLE")
    return candidate


def run_scp(source: Path, target: str, port: int | None) -> None:
    argv = [
        scp_executable(),
        "-B",
        "-q",
        "-oBatchMode=yes",
        "-oStrictHostKeyChecking=yes",
        "-oClearAllForwardings=yes",
        "-oForwardAgent=no",
        "-oPermitLocalCommand=no",
        "-oPasswordAuthentication=no",
        "-oKbdInteractiveAuthentication=no",
    ]
    if port is not None:
        argv.extend(["-P", str(port)])
    argv.extend(["--", str(source), target])
    try:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        try:
            return_code = process.wait(timeout=60)
        except subprocess.TimeoutExpired as exc:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            raise DeliveryError("SCP_TIMEOUT") from exc
    except DeliveryError:
        raise
    except OSError as exc:
        raise DeliveryError("SCP_UNAVAILABLE") from exc
    if return_code != 0:
        raise DeliveryError("SCP_FAILED")


def parse_args() -> argparse.Namespace:
    parser = DeliveryArgumentParser(add_help=False, exit_on_error=False)
    parser.add_argument("--receipt", required=True)
    parser.add_argument("--session", required=True)
    try:
        args = parser.parse_args()
    except (argparse.ArgumentError, TypeError) as exc:
        raise DeliveryError("INVALID_ARGUMENT") from exc
    if RECEIPT_RE.fullmatch(args.receipt) is None:
        raise DeliveryError("INVALID_ARGUMENT")
    if SESSION_RE.fullmatch(args.session) is None:
        raise DeliveryError("INVALID_ARGUMENT")
    return args


def main() -> int:
    claimed: Path | None = None
    lock_fd: int | None = None
    try:
        args = parse_args()
        root = state_root()
        lock_fd = acquire_delivery_lock(root)
        claimed = claim_receipt(root / "receipts", args.receipt)
        receipt = load_receipt(claimed)
        source, target, port = validated_receipt(receipt, args.receipt, args.session)
        require_classified(source)
        run_scp(source, target, port)
        print("SECRET_DELIVERY_OK")
        return 0
    except DeliveryError as exc:
        return fail(exc.code, exc.exit_code)
    except Exception:
        return fail("INTERNAL_ERROR")
    finally:
        if claimed is not None:
            try:
                claimed.unlink()
            except OSError:
                pass
        if lock_fd is not None:
            os.close(lock_fd)


if __name__ == "__main__":
    raise SystemExit(main())
