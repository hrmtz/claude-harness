{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Magi Deja Review prompt-consumption receipt",
  "type": "object",
  "properties": {
    "schema_version": {"const": "magi-deja-consumption/v1"},
    "phase": {"type": "string", "enum": ["fanout", "xfamily"]},
    "round": {"type": "integer", "minimum": 1},
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rendered_block_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "injected": {"type": "boolean"},
    "prompt_count": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "schema_version",
    "phase",
    "round",
    "providers",
    "target_sha",
    "protocol_sha",
    "selection_sha256",
    "rendered_block_sha256",
    "injected",
    "prompt_count",
    "created_at"
  ],
  "additionalProperties": false
}
