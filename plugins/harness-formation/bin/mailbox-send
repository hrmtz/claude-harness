#!/usr/bin/env bash
# mailbox-send — atomic formation mailbox append + recipient pane signal.
#
# Why this exists: appending a JSONL line to the mailbox alone does NOT notify
# the recipient pane (it only sees the message if it happens to poll). A
# non-destructive signal (pane option + optional display-message) is what pulls
# human attention without touching the recipient TUI buffer. Body injection into
# the prompt is opt-in only (--inject): pasting into a non-empty draft merges
# inputs (#166), and empty-prompt inject can still silently fail.
#
# Delivery contract (M0 / #166):
#   1. appended  — JSONL row is the sole durability guarantee
#   2. signaled  — @formation_mail_pending + display-message (zero keystrokes
#                  into the TUI prompt buffer)
#   3. inject    — optional exclusive wake via tmux_send_submit; never claimed
#                  as received ("receipt unconfirmed")
#
# Usage:
#   mailbox-send <to> <body> [--from NAME] [--session ID] \
#                [--no-nudge] [--inject] [--force]
#
#   <to>    registered worker id or recipient pane: "pane-25" | "%25" | "25"
#   <body>  message text (single arg; quote it)
#
# Options:
#   --from NAME    sender codename (default: window name of $TMUX_PANE minus
#                  "claude-"/"main-" prefix, or $MAILBOX_FROM)
#   --session ID   session uuid for the entry (default: $MAILBOX_SESSION|"unknown")
#   --no-nudge     append only; skip signal and inject (bulk ticks only)
#   --inject       also attempt prompt inject (exclusive workers / explicit wake).
#                  Default is OFF — draft non-destruction > immediacy (#166).
#   --force        bypass the credential-shaped-body guard (use with care)
#
# Exit: 0 ok / 2 usage / 3 credential-shaped body refused /
#       4 pane/signal unavailable / 5 injection refused (not exclusive)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/wake.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/mailbox.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/mailbox_notify.sh"

usage() { sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; }

FROM=""; SESSION=""; NUDGE=1; INJECT=0; FORCE=0
posargs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)     FROM="${2:-}"; shift 2;;
    --session)  SESSION="${2:-}"; shift 2;;
    --no-nudge) NUDGE=0; shift;;
    --inject)   INJECT=1; shift;;
    --force)    FORCE=1; shift;;
    -h|--help)  usage; exit 0;;
    --) shift; while [[ $# -gt 0 ]]; do posargs+=("$1"); shift; done;;
    *) posargs+=("$1"); shift;;
  esac
done
[[ ${#posargs[@]} -eq 2 ]] || { usage; exit 2; }
TO="${posargs[0]}"; BODY="${posargs[1]}"

# --- resolve sender codename ---
[[ -z "$FROM" ]] && FROM="${MAILBOX_FROM:-}"
if [[ -z "$FROM" && -n "${TMUX_PANE:-}" ]]; then
  wn="$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || true)"
  FROM="${wn#claude-}"; FROM="${FROM#main-}"
fi
FROM="${FROM:-unknown}"
SESSION="${SESSION:-${MAILBOX_SESSION:-unknown}}"

# --- normalize recipient: pane-NN (mailbox label) + %NN (tmux target) ---
raw="${TO#pane-}"; raw="${raw#%}"
TO_LABEL=""
TMUX_TARGET=""
[[ "$raw" =~ ^[0-9]+$ ]] && {
  TO_LABEL="pane-${raw}"
  TMUX_TARGET="%${raw}"
}

# Mailbox addressing is worker-id based; pane ids are delivery metadata. Resolve
# from the registry without touching tmux so --no-nudge remains append-only.
REGISTRY="${FORMATION_REGISTRY:-$FORMATION_HOME/formation/registry.jsonl}"
REGISTRY_EXCLUSIVE=0
if [[ -s "$REGISTRY" ]]; then
  registry_row="$(jq -c --arg to "$TO" --arg raw "$raw" --arg pane "$TMUX_TARGET" \
    'select(.id == $to or .id == $raw or ($pane != "" and .pane_id == $pane))' \
    "$REGISTRY" 2>/dev/null | tail -n1)"
  canonical_to="$(printf '%s' "$registry_row" | jq -r '.id // empty' 2>/dev/null || true)"
  if [[ -n "$canonical_to" ]]; then
    TO_LABEL="$canonical_to"
    TMUX_TARGET="$(printf '%s' "$registry_row" | jq -r '.pane_id')"
  fi
  [[ "$(printf '%s' "$registry_row" | jq -r '.exclusive_input // false' 2>/dev/null || true)" == "true" ]] &&
    REGISTRY_EXCLUSIVE=1
fi
if [[ -z "$TO_LABEL" || -z "$TMUX_TARGET" ]]; then
  echo "mailbox-send: unknown recipient '$TO' (use a numeric pane id or registered worker id)" >&2
  exit 2
fi

# --- canonical append under the shared mailbox lock ---
if SEQ="$(mailbox_append "$FROM" "$TO_LABEL" "$BODY" "$SESSION" "$FORCE")"; then
  :
else
  rc=$?
  [[ "$rc" -eq 3 ]] &&
    echo "REFUSED (exit 3): body looks credential-shaped. Reference key NAME only, never values. Override with --force if certain." >&2
  exit "$rc"
fi
echo "appended seq=$SEQ from=$FROM to=$TO_LABEL chars=${#BODY}"

# --- signal (default) / optional inject ---
if [[ "$NUDGE" -eq 1 ]]; then
  relay_pid_file="$FORMATION_HOME/formation/$TO_LABEL.relay_pid"
  relay_pid=""
  [[ -f "$relay_pid_file" ]] && relay_pid="$(cat "$relay_pid_file" 2>/dev/null || true)"
  relay_alive=0
  mailbox_relay_alive "$relay_pid" "$TO_LABEL" && relay_alive=1
  if [[ "$relay_alive" -eq 1 ]]; then
    echo "signal=pending relay_pid=$relay_pid pane=$TMUX_TARGET (relay owns signaling)"
  else
    if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$TMUX_TARGET"; then
      echo "WARN (exit 4): pane $TMUX_TARGET not found — message appended but NOT signaled." >&2
      exit 4
    fi
    if ! mailbox_signal_pane "$TMUX_TARGET" "$SEQ" "$FROM"; then
      echo "WARN (exit 4): message appended but pane $TMUX_TARGET could not be signaled." >&2
      exit 4
    fi
    echo "signaled $TMUX_TARGET (@formation_mail_pending=$SEQ; zero keystrokes into prompt)"
  fi

  if [[ "$INJECT" -eq 1 ]]; then
    exclusive="$(tmux show-options -p -v -t "$TMUX_TARGET" @formation_exclusive_input 2>/dev/null || true)"
    if [[ "$REGISTRY_EXCLUSIVE" -ne 1 || "$exclusive" != "1" ]]; then
      echo "REFUSED (exit 5): row is durable and signaled, but pane $TMUX_TARGET lacks the registry+pane --exclusive-input contract; prompt injection skipped." >&2
      exit 5
    fi
    # Opt-in exclusive wake only. Short nudge, not a substitute for pull:
    # full body remains in the mailbox JSONL.
    notify="[mailbox seq=${SEQ} from=${FROM}] pull inbox (body in log.jsonl; receipt unconfirmed)"
    FORMATION_SUBMIT_SETTLE_S="${MAILBOX_SUBMIT_SETTLE_S:-0.4}" \
    FORMATION_SUBMIT_RETRY_S="${MAILBOX_SUBMIT_RETRY_S:-0.5}" \
      tmux_send_submit "$TMUX_TARGET" "$notify"
    echo "inject=attempted $TMUX_TARGET (bracketed paste + gapped double-enter; receipt unconfirmed)"
  else
    echo "inject=skipped (default; --inject requires a Formation --exclusive-input worker)"
  fi
fi
