#!/usr/bin/env bash
# mailbox-send — atomic formation mailbox append + recipient pane signal.
#
# Why this exists: appending a JSONL line to the mailbox alone does NOT notify
# the recipient pane (it only sees the message if it happens to poll). A
# non-destructive signal (pane option + optional display-message) is what pulls
# human attention without touching the recipient TUI buffer. Body injection into
# the prompt is opt-in only (--inject): pasting into a non-empty draft merges
# inputs (#166), and empty-prompt inject can still silently fail.
#
# Delivery contract (M0 / #166):
#   1. appended  — JSONL row is the sole durability guarantee
#   2. signaled  — @formation_mail_pending + display-message (zero keystrokes
#                  into the TUI prompt buffer)
#   3. inject    — optional exclusive wake via tmux_send_submit; never claimed
#                  as received ("receipt unconfirmed")
#
# Usage:
#   mailbox-send <to> <body> [--from NAME] [--session ID] \
#                [--no-nudge] [--inject] [--force]
#
#   <to>    registered worker id or recipient pane: "pane-25" | "%25" | "25"
#   <body>  message text (single arg; quote it)
#
# Options:
#   --from NAME    explicit sender override and tmux-free/offline-safe identity.
#                  Default: FORMATION_SELF, then the pane's locked Formation
#                  identity, then MAILBOX_FROM/window fallback.
#   --session ID   session uuid for the entry (default: $MAILBOX_SESSION|"unknown")
#   --no-nudge     append only; skip signal and inject (bulk ticks only)
#   --inject       also attempt prompt inject (exclusive workers / explicit wake).
#                  Default is OFF — draft non-destruction > immediacy (#166).
#   --force        bypass the credential-shaped-body guard (use with care)
#
# Exit: 0 ok / 2 usage / 3 credential-shaped body refused /
#       4 pane/signal/nudge unavailable / 5 injection refused (not exclusive)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/mailbox.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/mailbox_delivery.sh"

usage() {
  awk 'NR == 1 { next }
       /^#/ { sub(/^# ?/, ""); print; next }
       { exit }' "$0"
}

FROM=""; SESSION=""; NUDGE=1; INJECT=0; FORCE=0
posargs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)     FROM="${2:-}"; shift 2;;
    --session)  SESSION="${2:-}"; shift 2;;
    --no-nudge) NUDGE=0; shift;;
    --inject)   INJECT=1; shift;;
    --force)    FORCE=1; shift;;
    -h|--help)  usage; exit 0;;
    --) shift; while [[ $# -gt 0 ]]; do posargs+=("$1"); shift; done;;
    *) posargs+=("$1"); shift;;
  esac
done
[[ ${#posargs[@]} -eq 2 ]] || { usage; exit 2; }
TO="${posargs[0]}"; BODY="${posargs[1]}"

# --- resolve sender codename ---
FROM="$(mailbox_resolve_sender "$FROM" unknown)"
SESSION="${SESSION:-${MAILBOX_SESSION:-unknown}}"

# Mailbox addressing is worker-id based; pane ids are delivery metadata. Resolve
# from the registry without touching tmux so --no-nudge remains append-only.
REGISTRY="${FORMATION_REGISTRY:-$FORMATION_HOME/formation/registry.jsonl}"
if ! mailbox_resolve_recipient "$TO" "$REGISTRY" 1; then
  echo "mailbox-send: unknown recipient '$TO' (use a numeric pane id or registered worker id)" >&2
  exit 2
fi
TO_LABEL="$MAILBOX_RECIPIENT_LABEL"
TMUX_TARGET="$MAILBOX_RECIPIENT_PANE"
REGISTRY_EXCLUSIVE="$MAILBOX_RECIPIENT_EXCLUSIVE"

# --- canonical append under the shared mailbox lock ---
if SEQ="$(mailbox_append "$FROM" "$TO_LABEL" "$BODY" "$SESSION" "$FORCE")"; then
  :
else
  rc=$?
  exit "$rc"
fi
echo "appended seq=$SEQ from=$FROM to=$TO_LABEL chars=${#BODY}"

# --- signal (default) / optional inject ---
if [[ "$NUDGE" -eq 1 ]]; then
  mailbox_signal_or_defer "$TO_LABEL" "$TMUX_TARGET" "$SEQ" "$FROM" \
    "$FORMATION_HOME/formation" || exit $?

  if [[ "$INJECT" -eq 1 ]]; then
    mailbox_inject_nudge "$TMUX_TARGET" "$SEQ" "$FROM" \
      "$REGISTRY_EXCLUSIVE" || exit $?
  else
    echo "inject=skipped (default; --inject requires a Formation --exclusive-input worker)"
  fi
fi
